## Monitoring and Alerting

### Security Events

<example>
# Security-focused alerts for platform operations
groups:
- name: security-alerts
  rules:
  - alert: UnauthorizedAPIAccess
    expr: rate(apiserver_audit_total{verb="create",objectRef_resource="secrets"}[5m]) > 0.1
    for: 0s
    labels:
      severity: critical
    annotations:
      summary: "Unauthorized secret creation detected"
      
  - alert: PrivilegedContainerCreated
    expr: increase(kube_pod_container_status_running{container=~".*privileged.*"}[5m]) > 0
    for: 0s
    labels:
      severity: high
    annotations:
      summary: "Privileged container detected"
      
  - alert: UnencryptedTraffic
    expr: rate(istio_request_total{security_policy="none"}[5m]) > 0
    for: 1m
    labels:
      severity: warning
    annotations:
      summary: "Unencrypted traffic detected"
</example>

