### **2. Complete Document Generation Script**

```bash
#!/bin/bash
# generate_team_docs.sh - Convert markdown with diagrams to DOCX

set -e

INPUT_MD="$1"
OUTPUT_DOCX="${INPUT_MD%.md}.docx"
TEMP_DIR="temp_diagrams"

echo "🔄 Generating diagrams and converting to DOCX..."

# Create temp directory for diagrams
mkdir -p "$TEMP_DIR"

# Extract and render Mermaid diagrams
echo "📊 Rendering Mermaid diagrams..."
mmdc -i "$INPUT_MD" -o "$TEMP_DIR/" -t neutral -b white

# Extract and render PlantUML diagrams (if any)
echo "🏗️ Rendering PlantUML diagrams..."
grep -n "```plantuml" "$INPUT_MD" | while read -r line; do
    line_num=$(echo "$line" | cut -d: -f1)
    diagram_file="$TEMP_DIR/plantuml_${line_num}.puml"
    
    # Extract PlantUML content
    sed -n "${line_num},/^```$/p" "$INPUT_MD" | sed '1d;$d' > "$diagram_file"
    
    # Generate PNG
    plantuml -tpng -o "$TEMP_DIR" "$diagram_file"
done

# Convert to DOCX with embedded images
echo "📄 Converting to DOCX..."
pandoc "$INPUT_MD" \
    --from markdown \
    --to docx \
    --output "$OUTPUT_DOCX" \
    --reference-doc=reference.docx \
    --extract-media="$TEMP_DIR"

echo "✅ Generated: $OUTPUT_DOCX"
echo "🗂️ Diagram images in: $TEMP_DIR"

# Clean up (optional)
# rm -rf "$TEMP_DIR"
```

