### **3. Automated Diagram Generation**

```python
# generate_diagrams.py
import subprocess
from pathlib import Path

def generate_all_diagrams():
    """Generate diagrams from all source files."""
    
    # Mermaid diagrams (handled by GitHub/GitLab automatically)
    print("✅ Mermaid diagrams render automatically")
    
    # PlantUML diagrams
    plantuml_files = Path("docs/diagrams/plantuml").glob("*.puml")
    for file in plantuml_files:
        subprocess.run([
            "plantuml", 
            "-tpng", 
            "-o", "../../../static/images/",
            str(file)
        ])
    print("✅ PlantUML diagrams generated")
    
    # D2 diagrams
    d2_files = Path("docs/diagrams/d2").glob("*.d2")
    for file in d2_files:
        output = f"static/images/{file.stem}.png"
        subprocess.run(["d2", str(file), output])
    print("✅ D2 diagrams generated")
    
    # Python diagrams
    python_files = Path("docs/diagrams/python").glob("*.py")
    for file in python_files:
        subprocess.run(["python", str(file)])
    print("✅ Python diagrams generated")

if __name__ == "__main__":
    generate_all_diagrams()
```

