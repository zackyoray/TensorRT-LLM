### Advanced Configuration

```python
# config.yaml for recursive docx generation
recursive_docx:
  # Starting point
  start_file: "README.md"
  
  # Output settings
  output:
    filename: "project_documentation.docx"
    include_timestamp: true
    
  # Crawling settings
  crawling:
    max_depth: 10
    follow_external_links: false
    timeout_seconds: 30
    
  # Exclusions
  exclude:
    patterns:
      - "node_modules"
      - ".git"
      - "test/"
      - "*.test.md"
    files:
      - "CONTRIBUTING.md"
      - "LICENSE.md"
      
  # Document structure
  structure:
    include_toc: true
    include_index: true
    preserve_hierarchy: true
    
  # Formatting
  formatting:
    code_font: "Consolas"
    body_font: "Arial"
    heading_color: "1F4788"
    link_color: "0563C1"
    
  # Advanced features
  features:
    process_diagrams: true
    embed_images: true
    convert_mermaid: true
    include_metadata: true
```

### CLI Tool Implementation

```python
#!/usr/bin/env python3
"""
CLI tool for recursive DOCX generation
"""

import click
import yaml
from pathlib import Path
from recursive_docx_generator import RecursiveDocxGenerator


@click.command()
@click.option('--start', '-s', default='README.md', help='Starting README file')
@click.option('--output', '-o', default='documentation.docx', help='Output DOCX file')
@click.option('--config', '-c', type=click.Path(exists=True), help='Configuration file')
@click.option('--max-depth', '-d', default=10, help='Maximum recursion depth')
@click.option('--exclude', '-e', multiple=True, help='Patterns to exclude')
@click.option('--include-external', is_flag=True, help='Include external links')
@click.option('--verbose', '-v', is_flag=True, help='Verbose output')
def generate_docx(start, output, config, max_depth, exclude, include_external, verbose):
    """Generate comprehensive DOCX from linked README files"""
    
    # Load configuration
    if config:
        with open(config, 'r') as f:
            cfg = yaml.safe_load(f)
            # Override with config values
            start = cfg.get('start_file', start)
            output = cfg.get('output', {}).get('filename', output)
            max_depth = cfg.get('crawling', {}).get('max_depth', max_depth)
            exclude = cfg.get('exclude', {}).get('patterns', list(exclude))
            include_external = cfg.get('crawling', {}).get('follow_external_links', include_external)
    
    # Setup logging
    if verbose:
        import logging
        logging.basicConfig(level=logging.DEBUG)
    
    # Create generator
    generator = RecursiveDocxGenerator(
        base_path='.',
        max_depth=max_depth,
        exclude_patterns=list(exclude),
        include_external=include_external
    )
    
    # Generate document
    click.echo(f"Starting recursive DOCX generation from {start}")
    try:
        output_file = generator.generate(start, output)
        click.echo(f"✓ Successfully generated: {output_file}")
        
        # Show statistics
        stats = generator.get_statistics()
        click.echo(f"  - Documents processed: {stats['total_documents']}")
        click.echo(f"  - Total pages: {stats['estimated_pages']}")
        click.echo(f"  - Links followed: {stats['links_followed']}")
        
    except Exception as e:
        click.echo(f"✗ Error: {str(e)}", err=True)
        raise click.Abort()


if __name__ == '__main__':
    generate_docx()
```

### Enhanced Features

```python
class EnhancedDocxGenerator(RecursiveDocxGenerator):
    """Enhanced generator with additional features"""
    
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.statistics = {
            'total_documents': 0,
            'total_words': 0,
            'total_images': 0,
            'total_code_blocks': 0,
            'total_tables': 0,
            'links_followed': 0,
            'errors': []
        }
    
    def _process_mermaid_diagrams(self, content: str) -> Tuple[str, List[str]]:
        """Convert Mermaid diagrams to images"""
        import subprocess
        import tempfile
        
        mermaid_pattern = r'```mermaid\n(.*?)\n```'
        diagrams = re.findall(mermaid_pattern, content, re.DOTALL)
        
        image_paths = []
        for i, diagram in enumerate(diagrams):
            with tempfile.NamedTemporaryFile(mode='w', suffix='.mmd', delete=False) as f:
                f.write(diagram)
                mmd_file = f.name
            
            png_file = f"{tempfile.gettempdir()}/diagram_{i}.png"
            
            try:
                # Use mermaid CLI to generate image
                subprocess.run([
                    'mmdc', '-i', mmd_file, '-o', png_file,
                    '-t', 'dark', '-b', 'transparent'
                ], check=True)
                
                image_paths.append(png_file)
                
                # Replace in content
                content = content.replace(
                    f'```mermaid\n{diagram}\n```',
                    f'![Diagram {i}]({png_file})'
                )
            except subprocess.CalledProcessError:
                self.statistics['errors'].append(f"Failed to render Mermaid diagram {i}")
            finally:
                os.unlink(mmd_file)
        
        return content, image_paths
    
    def _add_metadata_page(self, doc: Document):
        """Add metadata page with statistics"""
        doc.add_heading('Document Metadata', level=1)
        
        # Statistics table
        table = doc.add_table(rows=8, cols=2)
        table.style = 'Light List Accent 1'
        
        stats = [
            ('Total Documents', str(self.statistics['total_documents'])),
            ('Total Words', f"{self.statistics['total_words']:,}"),
            ('Total Images', str(self.statistics['total_images'])),
            ('Code Blocks', str(self.statistics['total_code_blocks'])),
            ('Tables', str(self.statistics['total_tables'])),
            ('Links Followed', str(self.statistics['links_followed'])),
            ('Generation Date', datetime.now().strftime('%Y-%m-%d %H:%M:%S')),
            ('Errors', str(len(self.statistics['errors'])))
        ]
        
        for i, (label, value) in enumerate(stats):
            table.cell(i, 0).text = label
            table.cell(i, 1).text = value
        
        # Error details if any
        if self.statistics['errors']:
            doc.add_heading('Generation Errors', level=2)
            for error in self.statistics['errors']:
                doc.add_paragraph(f'• {error}', style='List Bullet')
        
        doc.add_page_break()
    
    def _create_index(self, doc: Document):
        """Create alphabetical index of all topics"""
        doc.add_heading('Index', level=1)
        
        # Collect all headings
        index_entries = []
        
        def collect_headings(node: DocumentNode):
            if node.level > 0:
                # Extract all headings from content
                lines = node.content.split('\n')
                for line in lines:
                    if line.strip().startswith('#'):
                        heading = line.strip().lstrip('#').strip()
                        index_entries.append((heading, node.title))
            
            for child in node.children:
                collect_headings(child)
        
        collect_headings(self.doc_tree)
        
        # Sort and add to document
        index_entries.sort(key=lambda x: x[0].lower())
        
        current_letter = ''
        for heading, source in index_entries:
            first_letter = heading[0].upper()
            if first_letter != current_letter:
                current_letter = first_letter
                doc.add_heading(current_letter, level=2)
            
            para = doc.add_paragraph()
            para.add_run(f"{heading} ")
            para.add_run(f"({source})").italic = True
