## Model Development Workflow

### Experiment Tracking

```python
# %% [markdown]
# ## 5. Model Development <a id='modeling'></a>

# %%
class ExperimentTracker:
    """Track ML experiments in notebooks."""
    
    def __init__(self, experiment_name):
        self.experiment_name = experiment_name
        self.results = []
        self.timestamp = datetime.now()
        
    def log_experiment(self, model_name, params, metrics, notes=""):
        """Log experiment details."""
        experiment = {
            'timestamp': datetime.now(),
            'model': model_name,
            'params': params,
            'metrics': metrics,
            'notes': notes
        }
        self.results.append(experiment)
        
    def get_results_df(self):
        """Get results as DataFrame."""
        if not self.results:
            return pd.DataFrame()
        
        # Flatten nested dictionaries
        flattened_results = []
        for result in self.results:
            flat_result = {
                'timestamp': result['timestamp'],
                'model': result['model'],
                'notes': result['notes']
            }
            # Add parameters
            for key, value in result['params'].items():
                flat_result[f'param_{key}'] = value
            # Add metrics
            for key, value in result['metrics'].items():
                flat_result[f'metric_{key}'] = value
            
            flattened_results.append(flat_result)
        
        return pd.DataFrame(flattened_results)
    
    def save_results(self, filepath):
        """Save results to file."""
        df = self.get_results_df()
        df.to_csv(filepath, index=False)
        print(f"Results saved to {filepath}")

# Initialize experiment tracker
tracker = ExperimentTracker("customer_churn_prediction")

# %%
# Model training with experiment tracking
from sklearn.model_selection import GridSearchCV

# Define parameter grid
param_grid = {
    'n_estimators': [100, 200],
    'max_depth': [5, 10, None],
    'min_samples_split': [2, 5]
}

# Grid search with cross-validation
grid_search = GridSearchCV(
    RandomForestClassifier(random_state=RANDOM_SEED),
    param_grid,
    cv=5,
    scoring='roc_auc',
    n_jobs=-1,
    verbose=1
)

# Train model
grid_search.fit(X_train, y_train)

# Log results
tracker.log_experiment(
    model_name="RandomForest_GridSearch",
    params=grid_search.best_params_,
    metrics={
        'cv_score': grid_search.best_score_,
        'train_score': grid_search.score(X_train, y_train),
        'test_score': grid_search.score(X_test, y_test)
    },
    notes="Initial grid search for baseline model"
)

# Display results
display(tracker.get_results_df())
```

