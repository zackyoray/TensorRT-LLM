### Data Loading with Error Handling

```python
# %% [markdown]
# ## 3. Data Loading <a id='data-loading'></a>

# %%
def load_data(file_path, **kwargs):
    """Load data with error handling and basic validation."""
    try:
        # Detect file type and load accordingly
        file_ext = Path(file_path).suffix.lower()
        
        if file_ext == '.csv':
            df = pd.read_csv(file_path, **kwargs)
        elif file_ext == '.parquet':
            df = pd.read_parquet(file_path, **kwargs)
        elif file_ext in ['.xlsx', '.xls']:
            df = pd.read_excel(file_path, **kwargs)
        else:
            raise ValueError(f"Unsupported file format: {file_ext}")
        
        print(f"✓ Loaded {len(df):,} rows and {len(df.columns)} columns")
        print(f"Memory usage: {df.memory_usage().sum() / 1024**2:.2f} MB")
        
        return df
        
    except FileNotFoundError:
        print(f"❌ File not found: {file_path}")
        raise
    except Exception as e:
        print(f"❌ Error loading data: {str(e)}")
        raise

# Load datasets
df_customers = load_data(DATA_DIR / 'customers.csv')
df_transactions = load_data(DATA_DIR / 'transactions.parquet')

# Display basic information
display(df_customers.head())
print("\nData Types:")
print(df_customers.dtypes)
print("\nMissing Values:")
print(df_customers.isnull().sum())
```

## Interactive Visualizations

### Plotly Interactive Charts

```python
# %% [markdown]
# ## 4. Exploratory Data Analysis <a id='eda'></a>

# %%
# Create interactive visualizations
def create_interactive_dist(df, column, title=None):
    """Create interactive distribution plot."""
    fig = px.histogram(
        df, 
        x=column, 
        marginal="box",
        title=title or f"Distribution of {column}",
        template="plotly_white"
    )
    fig.update_layout(
        showlegend=False,
        height=400,
        font=dict(family="Arial", size=12)
    )
    return fig

# Analyze numerical features
numerical_cols = df_customers.select_dtypes(include=[np.number]).columns

for col in numerical_cols[:3]:  # Show first 3
    fig = create_interactive_dist(df_customers, col)
    fig.show()

# %%
# Correlation heatmap
def plot_correlation_heatmap(df, figsize=(10, 8)):
    """Create interactive correlation heatmap."""
    # Calculate correlation matrix
    corr_matrix = df.select_dtypes(include=[np.number]).corr()
    
    # Create heatmap
    fig = go.Figure(data=go.Heatmap(
        z=corr_matrix.values,
        x=corr_matrix.columns,
        y=corr_matrix.columns,
        colorscale='RdBu',
        zmid=0,
        text=np.round(corr_matrix.values, 2),
        texttemplate='%{text}',
        textfont={"size": 10},
        hoverongaps=False
    ))
    
    fig.update_layout(
        title='Feature Correlation Matrix',
        width=figsize[0]*100,
        height=figsize[1]*100,
        font=dict(size=12)
    )
    
    return fig

correlation_fig = plot_correlation_heatmap(df_customers)
correlation_fig.show()
```

