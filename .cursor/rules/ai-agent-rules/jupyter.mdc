# ```

# %%
# Interactive widgets example
import ipywidgets as widgets
from IPython.display import display

def interactive_data_filter(df):
    """Create interactive filtering widget."""
    
    # Create widgets
    column_dropdown = widgets.Dropdown(
        options=df.columns.tolist(),
        description='Column:'
    )
    
    value_slider = widgets.FloatSlider(
        min=0,
        max=100,
        step=1,
        description='Threshold:'
    )
    
    output = widgets.Output()
    
    def update_filter(change):
        with output:
            output.clear_output()
            if column_dropdown.value in df.select_dtypes(include=[np.number]).columns:
                filtered = df[df[column_dropdown.value] > value_slider.value]
                print(f"Filtered {len(filtered)} rows where {column_dropdown.value} > {value_slider.value}")
                display(filtered.head())
    
    column_dropdown.observe(update_filter, names='value')
    value_slider.observe(update_filter, names='value')
    
    return widgets.VBox([column_dropdown, value_slider, output])

# Create interactive filter
interactive_filter = interactive_data_filter(df_customers)
display(interactive_filter)
```

