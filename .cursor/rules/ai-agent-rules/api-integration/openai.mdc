## Chat Completions

### Basic Chat Implementation

```python
from typing import List, Dict, Optional
import tiktoken

class ChatCompletionHandler:
    """Handle chat completions with best practices"""
    
    def __init__(self, client: OpenAIClient):
        self.client = client
        self.encoding = tiktoken.encoding_for_model("gpt-3.5-turbo")
    
    def count_tokens(self, messages: List[Dict[str, str]], model: str = "gpt-3.5-turbo") -> int:
        """Count tokens in messages"""
        try:
            encoding = tiktoken.encoding_for_model(model)
        except KeyError:
            encoding = tiktoken.get_encoding("cl100k_base")
        
        num_tokens = 0
        for message in messages:
            num_tokens += 4  # Every message follows <im_start>{role/name}\n{content}<im_end>\n
            for key, value in message.items():
                num_tokens += len(encoding.encode(value))
                if key == "name":
                    num_tokens += -1  # Role is omitted if name is present
        num_tokens += 2  # Every reply is primed with <im_start>assistant
        return num_tokens
    
    def create_chat_completion(
        self,
        messages: List[Dict[str, str]],
        model: str = None,
        temperature: float = 0.7,
        max_tokens: Optional[int] = None,
        stream: bool = False,
        **kwargs
    ):
        """Create chat completion with error handling"""
        model = model or self.client.DEFAULT_CHAT_MODEL
        
        # Check token limits
        input_tokens = self.count_tokens(messages, model)
        model_limits = {
            "gpt-4": 8192,
            "gpt-4-32k": 32768,
            "gpt-3.5-turbo": 4096,
            "gpt-3.5-turbo-16k": 16384
        }
        
        model_limit = model_limits.get(model, 4096)
        if input_tokens > model_limit * 0.9:  # Leave room for response
            logger.warning(f"Input tokens ({input_tokens}) approaching model limit ({model_limit})")
        
        try:
            response = self.client.client.chat.completions.create(
                model=model,
                messages=messages,
                temperature=temperature,
                max_tokens=max_tokens,
                stream=stream,
                **kwargs
            )
            
            if stream:
                return self._handle_stream(response)
            else:
                return self._handle_response(response)
                
        except Exception as e:
            logger.error(f"Chat completion error: {e}")
            return self._handle_error(e)
    
    def _handle_response(self, response):
        """Process non-streaming response"""
        return {
            "content": response.choices[0].message.content,
            "usage": {
                "prompt_tokens": response.usage.prompt_tokens,
                "completion_tokens": response.usage.completion_tokens,
                "total_tokens": response.usage.total_tokens
            },
            "model": response.model,
            "finish_reason": response.choices[0].finish_reason
        }
    
    def _handle_stream(self, stream):
        """Process streaming response"""
        for chunk in stream:
            if chunk.choices[0].delta.content:
                yield chunk.choices[0].delta.content
    
    def _handle_error(self, error):
        """Handle API errors gracefully"""
        error_map = {
            "rate_limit_exceeded": "Rate limit hit. Please wait and retry.",
            "model_not_found": "Invalid model specified.",
            "invalid_api_key": "Invalid API key provided.",
            "insufficient_quota": "Quota exceeded. Check billing.",
        }
        
        error_type = getattr(error, 'type', 'unknown')
        message = error_map.get(error_type, str(error))
        
        return {
            "error": True,
            "error_type": error_type,
            "message": message
        }
```

### Advanced Chat Features

```python
class AdvancedChatHandler(ChatCompletionHandler):
    """Advanced chat features including function calling"""
    
    def create_chat_with_functions(
        self,
        messages: List[Dict[str, str]],
        functions: List[Dict[str, Any]],
        function_call: str = "auto",
        **kwargs
    ):
        """Chat completion with function calling"""
        try:
            response = self.client.client.chat.completions.create(
                model="gpt-3.5-turbo-0613",  # Function calling requires specific models
                messages=messages,
                functions=functions,
                function_call=function_call,
                **kwargs
            )
            
            message = response.choices[0].message
            
            # Check if function was called
            if message.function_call:
                return {
                    "function_call": {
                        "name": message.function_call.name,
                        "arguments": message.function_call.arguments
                    },
                    "usage": response.usage.dict()
                }
            else:
                return {
                    "content": message.content,
                    "usage": response.usage.dict()
                }
                
        except Exception as e:
            logger.error(f"Function calling error: {e}")
            return self._handle_error(e)
    
    def create_conversation_chain(
        self,
        system_prompt: str,
        conversation_history: List[Dict[str, str]] = None,
        max_history_tokens: int = 2000
    ):
        """Manage conversation with history truncation"""
        messages = [{"role": "system", "content": system_prompt}]
        
        if conversation_history:
            # Truncate history to fit token limit
            history_tokens = 0
            truncated_history = []
            
            for msg in reversed(conversation_history):
                msg_tokens = len(self.encoding.encode(msg.get("content", "")))
                if history_tokens + msg_tokens > max_history_tokens:
                    break
                truncated_history.insert(0, msg)
                history_tokens += msg_tokens
            
            messages.extend(truncated_history)
        
        return messages

