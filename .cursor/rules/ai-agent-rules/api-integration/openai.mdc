## Embeddings

### Text Embeddings Implementation

```python
import numpy as np
from typing import List, Union
import pickle

class EmbeddingHandler:
    """Handle text embeddings for semantic search and similarity"""
    
    def __init__(self, client: OpenAIClient):
        self.client = client
        self.cache = {}  # Simple in-memory cache
    
    def create_embedding(
        self,
        text: Union[str, List[str]],
        model: str = None
    ) -> Union[List[float], List[List[float]]]:
        """Create embeddings for text"""
        model = model or self.client.DEFAULT_EMBEDDING_MODEL
        
        # Handle single string
        if isinstance(text, str):
            text = [text]
            single_input = True
        else:
            single_input = False
        
        # Check cache
        cache_keys = [f"{model}:{t[:50]}" for t in text]
        cached_results = []
        uncached_texts = []
        uncached_indices = []
        
        for i, (key, t) in enumerate(zip(cache_keys, text)):
            if key in self.cache:
                cached_results.append((i, self.cache[key]))
            else:
                uncached_texts.append(t)
                uncached_indices.append(i)
        
        # Get embeddings for uncached texts
        if uncached_texts:
            try:
                response = self.client.client.embeddings.create(
                    model=model,
                    input=uncached_texts
                )
                
                # Cache results
                for i, embedding in enumerate(response.data):
                    idx = uncached_indices[i]
                    key = cache_keys[idx]
                    self.cache[key] = embedding.embedding
                    cached_results.append((idx, embedding.embedding))
                
            except Exception as e:
                logger.error(f"Embedding error: {e}")
                raise
        
        # Sort by original index
        cached_results.sort(key=lambda x: x[0])
        embeddings = [emb for _, emb in cached_results]
        
        return embeddings[0] if single_input else embeddings
    
    def cosine_similarity(self, vec1: List[float], vec2: List[float]) -> float:
        """Calculate cosine similarity between two vectors"""
        vec1 = np.array(vec1)
        vec2 = np.array(vec2)
        
        dot_product = np.dot(vec1, vec2)
        norm1 = np.linalg.norm(vec1)
        norm2 = np.linalg.norm(vec2)
        
        return dot_product / (norm1 * norm2)
    
    def find_similar(
        self,
        query_embedding: List[float],
        embeddings: List[List[float]],
        texts: List[str],
        top_k: int = 5,
        threshold: float = 0.7
    ) -> List[Dict[str, Any]]:
        """Find similar texts based on embeddings"""
        similarities = []
        
        for i, embedding in enumerate(embeddings):
            similarity = self.cosine_similarity(query_embedding, embedding)
            if similarity >= threshold:
                similarities.append({
                    "text": texts[i],
                    "similarity": similarity,
                    "index": i
                })
        
        # Sort by similarity
        similarities.sort(key=lambda x: x["similarity"], reverse=True)
        
        return similarities[:top_k]
    
    def save_embeddings(self, embeddings: Dict[str, List[float]], filepath: str):
        """Save embeddings to file"""
        with open(filepath, 'wb') as f:
            pickle.dump(embeddings, f)
    
    def load_embeddings(self, filepath: str) -> Dict[str, List[float]]:
        """Load embeddings from file"""
        with open(filepath, 'rb') as f:
            return pickle.load(f)
```

## Prompt Engineering

### Prompt Template Management

```python
from string import Template
from typing import Dict, Any

class PromptManager:
    """Manage and optimize prompts"""
    
    def __init__(self):
        self.templates = {}
        self.load_default_templates()
    
    def load_default_templates(self):
        """Load default prompt templates"""
        self.templates = {
            "summarization": Template("""
Please summarize the following text in $style style.
Keep the summary under $max_words words.
Focus on: $focus_areas

Text to summarize:
$text

Summary:
"""),
            "classification": Template("""
Classify the following text into one of these categories: $categories

Consider these criteria:
$criteria

Text: $text

Classification:
"""),
            "extraction": Template("""
Extract the following information from the text:
$fields

Format the output as JSON.

Text: $text

Extracted information:
"""),
            "code_generation": Template("""
Generate $language code that:
$requirements

Additional constraints:
- $constraints

Code:
""")
        }
    
    def create_prompt(self, template_name: str, **kwargs) -> str:
        """Create prompt from template"""
        if template_name not in self.templates:
            raise ValueError(f"Template '{template_name}' not found")
        
        template = self.templates[template_name]
        return template.safe_substitute(**kwargs)
    
    def add_template(self, name: str, template_string: str):
        """Add custom template"""
        self.templates[name] = Template(template_string)
    
    def optimize_prompt(self, prompt: str, model: str = "gpt-3.5-turbo") -> str:
        """Optimize prompt for better results"""
        optimizations = []
        
        # Check prompt length
        if len(prompt) < 50:
            optimizations.append("Consider adding more context or examples")
        
        # Check for clear instructions
        instruction_keywords = ["please", "must", "should", "need to", "require"]
        if not any(keyword in prompt.lower() for keyword in instruction_keywords):
            optimizations.append("Add clear instructions or requirements")
        
        # Check for examples
        if "example:" not in prompt.lower() and "e.g." not in prompt.lower():
            optimizations.append("Consider adding examples for clarity")
        
        # Check for output format specification
        format_keywords = ["format", "structure", "output", "return"]
        if not any(keyword in prompt.lower() for keyword in format_keywords):
            optimizations.append("Specify desired output format")
        
        if optimizations:
            logger.info(f"Prompt optimization suggestions: {', '.join(optimizations)}")
        
        return prompt

# Example usage
