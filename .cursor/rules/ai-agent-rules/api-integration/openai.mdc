## Error Handling and Retries

### Robust Error Management

```python
import time
from functools import wraps
from typing import Callable

class RateLimitHandler:
    """Handle rate limiting and retries"""
    
    def __init__(self, max_retries: int = 3, base_delay: float = 1.0):
        self.max_retries = max_retries
        self.base_delay = base_delay
    
    def with_retry(self, func: Callable):
        """Decorator for automatic retry logic"""
        @wraps(func)
        def wrapper(*args, **kwargs):
            last_exception = None
            
            for attempt in range(self.max_retries):
                try:
                    return func(*args, **kwargs)
                    
                except Exception as e:
                    last_exception = e
                    error_type = getattr(e, 'type', '')
                    
                    if 'rate_limit' in str(error_type):
                        # Exponential backoff for rate limits
                        delay = self.base_delay * (2 ** attempt)
                        logger.warning(f"Rate limit hit. Waiting {delay}s...")
                        time.sleep(delay)
                        
                    elif 'timeout' in str(error_type):
                        # Shorter delay for timeouts
                        time.sleep(self.base_delay)
                        
                    else:
                        # Don't retry other errors
                        raise
            
            raise last_exception
        
        return wrapper

# Usage monitoring
class UsageMonitor:
    """Monitor API usage and costs"""
    
    def __init__(self):
        self.usage_data = {
            "total_tokens": 0,
            "total_cost": 0.0,
            "requests": 0,
            "model_usage": {}
        }
        
        # Pricing per 1K tokens (example rates)
        self.pricing = {
            "gpt-4": {"input": 0.03, "output": 0.06},
            "gpt-3.5-turbo": {"input": 0.0015, "output": 0.002},
            "text-embedding-3-small": {"input": 0.00002, "output": 0}
        }
    
    def track_usage(self, model: str, usage: Dict[str, int]):
        """Track token usage and calculate costs"""
        prompt_tokens = usage.get("prompt_tokens", 0)
        completion_tokens = usage.get("completion_tokens", 0)
        total_tokens = usage.get("total_tokens", 0)
        
        # Update totals
        self.usage_data["total_tokens"] += total_tokens
        self.usage_data["requests"] += 1
        
        # Track per model
        if model not in self.usage_data["model_usage"]:
            self.usage_data["model_usage"][model] = {
                "tokens": 0,
                "requests": 0,
                "cost": 0.0
            }
        
        self.usage_data["model_usage"][model]["tokens"] += total_tokens
        self.usage_data["model_usage"][model]["requests"] += 1
        
        # Calculate cost
        if model in self.pricing:
            input_cost = (prompt_tokens / 1000) * self.pricing[model]["input"]
            output_cost = (completion_tokens / 1000) * self.pricing[model]["output"]
            total_cost = input_cost + output_cost
            
            self.usage_data["total_cost"] += total_cost
            self.usage_data["model_usage"][model]["cost"] += total_cost
    
    def get_report(self) -> Dict[str, Any]:
        """Get usage report"""
        return {
            "summary": {
                "total_requests": self.usage_data["requests"],
                "total_tokens": self.usage_data["total_tokens"],
                "total_cost": round(self.usage_data["total_cost"], 4),
                "average_tokens_per_request": (
                    self.usage_data["total_tokens"] / self.usage_data["requests"]
                    if self.usage_data["requests"] > 0 else 0
                )
            },
            "by_model": self.usage_data["model_usage"]
        }
